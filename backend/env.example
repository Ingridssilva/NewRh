# Copie este arquivo para ".env" e preencha com seus próprios valores.
# Nunca faça commit do arquivo ".env" real (ele já está no .gitignore).

# --- Banco de dados (PostgreSQL / Supabase) ---
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# --- Autenticação ---
SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
PORT=8080
BASE_URL=http://localhost:8080

# --- Microsoft OAuth2 / Graph API (login SSO, SharePoint, e-mail) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=rh@suaempresa.com.br

# --- E-mail ---
EMAIL_ENABLED=false
RH_EMAIL=rh@suaempresa.com.br

# --- SharePoint (planilha de colaboradores) ---
SHAREPOINT_COLAB_FILE_ID=

# --- Alertas automáticos ---
ALERTA_DIAS_PARADO=5
